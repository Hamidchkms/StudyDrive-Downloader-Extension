{
  "manifest_version": 3,
  "name": "StudyDrive Downloader Extension",
  "version": "1.2",
  "description": "Download a StudyDrive document using the right-click menu or toolbar icon.",
  "icons": { "128": "icon.png" },
  "action": {
    "default_title": "Download StudyDrive document",
    "default_icon": "icon.png"
  },
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "background": { "service_worker": "background.js" }
}
